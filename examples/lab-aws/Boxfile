# A local AWS lab, against Floci.
# Floci is a local AWS emulator (a drop-in LocalStack replacement) that
# serves AWS-shaped APIs on port 4566, so infrastructure code can be tried
# without a billable account.
#
# Baked in: AWS CLI, Terraform, boto3, jq. The env below points every tool
# at Floci with throwaway credentials.
#
# Run Floci in its own container/sandbox or on the host, then here:
#
#   box shell lab-aws
#   cp /path/to/examples/lab-aws/main.tf /data && cd /data
#   terraform init && terraform apply
#   aws s3 ls
#
# main.tf (next to this file) is the sample stack. Copy it into /data so
# terraform state persists.
#
# Networking note: if Floci runs on the host, localhost from inside the
# sandbox is the sandbox, not the host. Set the endpoint vars below to the
# host's bridge address (e.g. http://10.88.0.1:4566) in that case.

base: docker.io/library/debian:bookworm-slim

cpus: 2
ram_mib: 2048
network: bridge
timeout_seconds: 0

packages:
  - python3-boto3
  - jq
  - git
  - curl
  - unzip
  - vim

run:
  # Terraform
  - curl -fsSL https://releases.hashicorp.com/terraform/1.10.3/terraform_1.10.3_linux_amd64.zip -o /tmp/tf.zip && unzip -q /tmp/tf.zip -d /usr/local/bin && rm /tmp/tf.zip
  # AWS CLI v2 (debian's package predates AWS_ENDPOINT_URL support)
  - curl -fsSL https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip -o /tmp/awscliv2.zip && unzip -q /tmp/awscliv2.zip -d /tmp && /tmp/aws/install && rm -rf /tmp/aws /tmp/awscliv2.zip

env:
  FLOCI_ENDPOINT: http://host.containers.internal:4566
  AWS_ENDPOINT_URL: http://host.containers.internal:4566
  AWS_ACCESS_KEY_ID: test
  AWS_SECRET_ACCESS_KEY: test
  AWS_DEFAULT_REGION: us-east-1
