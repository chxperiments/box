# A Python development sandbox.
# Demonstrates: apt packages, a build step, environment variables.

base: docker.io/library/debian:bookworm-slim

cpus: 4
ram_mib: 4096
network: bridge          # needs the internet for pip
timeout_seconds: 0       # no limit; you drive it interactively

packages:
  - python3
  - python3-pip
  - python3-venv
  - git
  - build-essential

run:
  - pip3 install --break-system-packages --quiet ruff pytest

env:
  PYTHONDONTWRITEBYTECODE: "1"
  PIP_DISABLE_PIP_VERSION_CHECK: "1"
